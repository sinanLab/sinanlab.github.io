---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/utils';
import '../styles/global.css';
interface Props { title: string; description?: string; active?: string; article?: boolean; noindex?: boolean }
const { title, description = profile.description, active = '', article = false, noindex = false } = Astro.props;
const fullTitle = `${title} · ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(withBase('images/social-card.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121b1a" media="(prefers-color-scheme: dark)" />
    {(noindex || profile.nameIsPlaceholder) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Systems biology — cells, signals, and time" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('academic-theme');
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light'
          ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header active={active} />
    <main id="main-content" class="container" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
