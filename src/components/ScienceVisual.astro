---
interface Props { type: 'dynamics' | 'segmentation' | 'timeseries'; large?: boolean }
const { type, large = false } = Astro.props;
const labels = { dynamics: 'Illustrative oscillating cell-signaling traces; no experimental data.', segmentation: 'Illustrative cell outlines and segmented nuclei; no microscopy data.', timeseries: 'Illustrative heatmap of single-cell trajectories; no experimental data.' };
const cells = [[49,45,23,17,-20],[120,36,25,18,25],[197,48,26,18,-15],[269,33,20,17,30],[78,111,26,19,20],[157,101,22,19,-35],[234,115,26,18,15],[310,100,20,22,-20],[330,39,14,18,0]];
const colors = ['#e2edeb', '#c5dcd6', '#91c0b5', '#5e9e90', '#2e7869', '#20594e'];
---
<div class:list={['science-visual', `visual-${type}`, { 'visual-large': large }]}>
  <svg viewBox="0 0 360 170" role="img" aria-label={labels[type]}>
    {type === 'dynamics' && <>
      <g stroke="currentColor" opacity=".1"><path d="M38 35h294M38 70h294M38 105h294M38 140h294M38 25v115M111 25v115M184 25v115M257 25v115M330 25v115" /></g>
      <g fill="none" stroke-width="2.3" stroke-linecap="round">
        <path stroke="#9bacc5" d="M38 130C55 130 57 37 77 40S92 127 111 122s24-65 41-64 23 58 40 55 24-49 41-47 25 44 42 41 25-31 40-30 14 13 17 15" />
        <path stroke="#37776a" d="M38 136C58 136 62 51 82 53s20 78 38 70 26-57 44-54 19 53 38 49 24-40 40-37 23 30 43 26 27-22 45-17" />
        <path stroke="#b09a78" opacity=".8" d="M38 132C56 132 70 60 87 66s19 67 38 56 23-44 40-37 25 34 43 29 28-30 44-23 34 16 50 10 20-6 30-5" />
      </g>
      <g fill="currentColor" opacity=".65" font-family="Arial, sans-serif" font-size="9"><text x="38" y="157">0</text><text x="305" y="157">Time →</text><text x="40" y="16">Signal</text></g>
    </>}
    {type === 'segmentation' && <>
      {cells.map(([x,y,rx,ry,rotation], i) => <g transform={`rotate(${rotation} ${x} ${y})`}>
        <ellipse cx={x} cy={y} rx={rx + 7} ry={ry + 6} fill="none" stroke="#80b6a6" stroke-width="1" opacity=".4" />
        <ellipse cx={x} cy={y} rx={rx} ry={ry} fill="#477f6f" fill-opacity=".18" stroke="#8dc8b7" stroke-width="1.3" />
        <ellipse cx={x - 2} cy={y + 1} rx={rx * .38} ry={ry * .5} fill="#aed9b5" fill-opacity={.6 + i % 3 * .1} />
      </g>)}
      <path d="M279 150h49" stroke="#beded0" stroke-width="2" />
      <text x="26" y="155" fill="#beded0" font-family="Arial, sans-serif" font-size="9">Segmentation schematic</text>
    </>}
    {type === 'timeseries' && <>
      {Array.from({length: 9}, (_, row) => Array.from({length: 24}, (_, col) => {
        const level = Math.round((Math.sin(col * .55 - row * .7) * Math.exp(-col / 33) + 1) * 2.5);
        return <rect x={43 + col * 11.6} y={22 + row * 12.7} width="10.1" height="10.8" rx="1" fill={colors[level]} />;
      }))}
      <g fill="currentColor" opacity=".65" font-family="Arial, sans-serif" font-size="9"><text x="43" y="155">Individual cells × time</text><text x="288" y="155">Time →</text></g>
    </>}
  </svg>
</div>
