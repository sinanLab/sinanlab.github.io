---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { profile } from '../data/profile';
import { withBase, formatDate, dateDescending, publicationDescending } from '../lib/utils';
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.selected)).sort((a,b) => a.data.order - b.data.order);
const publications = (await getCollection('publications', ({ data }) => !data.draft && data.selected)).sort(publicationDescending);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(dateDescending).slice(0, 2);
const news = await Promise.all((await getCollection('news', ({ data }) => !data.draft)).sort(dateDescending).slice(0, 3).map(async entry => ({ entry, ...(await render(entry)) })));
---
<BaseLayout title="Home" active="Home">
  <section class="hero" aria-labelledby="profile-name">
    <div>
      <p class="eyebrow"><span class="eyebrow-dot"></span>{profile.role} · {profile.field}</p>
      <h1 id="profile-name">{profile.name}<span class="brand-period">.</span></h1>
      <p class="hero-role">{profile.institution || 'Institution to be added'}{profile.nameIsPlaceholder && <> · <span class="placeholder-badge">Profile placeholder</span></>}</p>
      <h2 class="hero-headline">{profile.headline}</h2>
      <div class="hero-bio">{profile.biography.map(paragraph => <p>{paragraph}</p>)}</div>
      {profile.biographyIsPlaceholder && <span class="small muted">Draft biography based on the supplied research interests.</span>}
      <div class="hero-actions">
        <a class="button button-primary" href={withBase('research/')}>Explore my research<Icon name="arrow" size={16} /></a>
        <a class="button" href={withBase('cv/')}><Icon name="file" size={16} />Curriculum vitae</a>
        {profile.email && <a class="button" href={`mailto:${profile.email}`}><Icon name="mail" size={16} />Email</a>}
      </div>
    </div>
    <aside class="profile-card" aria-label="Profile photograph and affiliation">
      {profile.photo ? <img class="portrait" src={withBase(profile.photo)} alt={profile.photoAlt || `Portrait of ${profile.name}`} width="488" height="524" fetchpriority="high" /> : <div class="portrait-placeholder"><span class="portrait-icon"><Icon name="user" size={38} /></span><p>Your photograph here</p></div>}
      <div class="profile-caption">
        <p><strong>{profile.role} in {profile.field.toLowerCase()}</strong></p>
        <p>{profile.department || 'Department to be added'}</p>
        <p>{profile.institution || 'Institution to be added'}</p>
        {profile.location && <p>{profile.location}</p>}
        <div class="profile-socials">{profile.profiles.filter(link => link.url).map(link => <a href={link.url}>{link.label}</a>)}</div>
      </div>
    </aside>
  </section>

  <div class="interest-strip"><span>Research interests</span><ul>{profile.interests.map(interest => <li>{interest}</li>)}</ul></div>

  <section class="section" aria-labelledby="selected-projects">
    <div class="section-heading"><h2 id="selected-projects">Selected research</h2><a class="text-link" href={withBase('projects/')}>All projects<Icon name="arrow" size={16} /></a></div>
    <div class="project-grid">{projects.slice(0,3).map(project => <ProjectCard project={project} />)}</div>
    {projects.some(project => project.data.placeholder) && <p class="figure-note">Project templates based on the supplied research interests. Schematics are illustrative, not experimental results.</p>}
    {projects.length === 0 && <p class="muted">Selected projects will appear here when available.</p>}
  </section>

  <div class="home-bottom">
    <section class="section" aria-labelledby="news-title">
      <div class="section-heading"><h2 id="news-title">News & updates</h2><span class="small muted">Along the way</span></div>
      <div class="news-list">{news.map(({ entry, Content }) => <article class="news-item"><div class="news-date">{entry.data.date ? <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time> : 'Forthcoming'}</div><div>{entry.data.placeholder && <span class="placeholder-badge">Placeholder</span>}<Content /></div></article>)}</div>
      {news.length === 0 && <p class="muted">No updates have been added yet.</p>}
    </section>
    <section class="section" aria-labelledby="notes-title">
      <div class="section-heading"><h2 id="notes-title">From the notebook</h2><a class="text-link" href={withBase('blog/')}>All posts<Icon name="arrow" size={16} /></a></div>
      {posts.map(post => <article class="note-teaser"><div class="note-meta"><span>{post.data.category}</span>{post.data.placeholder && <span class="placeholder-badge">Placeholder</span>}{post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}</div><h3><a href={withBase(`blog/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}
      {posts.length === 0 && <p class="muted">Research notes will appear here when available.</p>}
    </section>
  </div>

  <section class="section" aria-labelledby="publications-title">
    <div class="section-heading"><h2 id="publications-title">Selected publications</h2><a class="text-link" href={withBase('publications/')}>All publications<Icon name="arrow" size={16} /></a></div>
    {publications.slice(0,3).map(publication => <PublicationEntry publication={publication} />)}
    {publications.length === 0 && <p class="muted">Selected publications will appear here when available.</p>}
  </section>
</BaseLayout>
