---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { withBase, formatDate, dateDescending } from '../../lib/utils';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(dateDescending);
---
<BaseLayout title="Blog" active="Blog" description="Research notes, methods, and ideas from the research process.">
  <PageHeading eyebrow="From the notebook" title="Notes & ideas" description="A space for methods, reflections, and the work between the figures." />
  <div class="blog-list">{posts.map(post => <article class="note-teaser"><div class="note-meta"><span>{post.data.category}</span>{post.data.date ? <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> : <span>Forthcoming</span>}{post.data.placeholder && <span class="placeholder-badge">Editable placeholder</span>}</div><h2><a href={withBase(`blog/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={withBase(`blog/${post.id}/`)} aria-label={`Read ${post.data.title}`}>Read note<Icon name="arrow" size={15} /></a></article>)}</div>
  {posts.length === 0 && <div class="empty-state"><h2>Notes forthcoming</h2><p>New posts will appear here when published.</p></div>}
</BaseLayout>
