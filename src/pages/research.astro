---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ScienceVisual from '../components/ScienceVisual.astro';
import Icon from '../components/Icon.astro';
import { researchThemes, researchIsPlaceholder } from '../data/research';
import { withBase } from '../lib/utils';
---
<BaseLayout title="Research" active="Research" description="Research themes in systems biology, NF-κB dynamics, microscopy analysis, and single-cell time series.">
  <PageHeading eyebrow="Research" title="Cells, signals, and time." description="Research interests at the intersection of systems biology, microscopy, and computational analysis." />
  {researchIsPlaceholder && <div class="notice">These research themes are based on the supplied areas of interest. Specific studies, methods, affiliations, and findings are awaiting verified content.</div>}
  {researchThemes.map((theme, index) => <section class="research-theme"><div><span class="theme-index">0{index + 1} / RESEARCH THEME</span><h2>{theme.title}</h2><p>{theme.description}</p><a class="text-link" href={withBase(`projects/${theme.project}/`)}>{researchIsPlaceholder ? 'Explore this project outline' : 'Explore the project'}<Icon name="arrow" size={16} /></a></div><figure><ScienceVisual type={theme.visual} /><figcaption>{theme.caption}</figcaption></figure></section>)}
  <section class="workflow-strip" aria-labelledby="workflow-title"><h2 id="workflow-title">Connecting the research themes</h2><p class="small muted">A conceptual path from biological questions to quantitative interpretation.</p><ol><li>Biological question</li><li>Imaging & measurement</li><li>Computational analysis</li><li>Results & interpretation</li></ol></section>
</BaseLayout>
