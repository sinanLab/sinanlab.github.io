---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import Icon from '../components/Icon.astro';
import { publicationDescending } from '../lib/utils';
const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(publicationDescending);
const years = [...new Set(publications.map(item => item.data.year).filter((year): year is number => year !== null))].sort((a,b) => b-a);
const types = [...new Set(publications.map(item => item.data.type))].sort();
const realCount = publications.filter(item => !item.data.placeholder).length;
---
<BaseLayout title="Publications" active="Publications" description="Publications, abstracts, citations, and links to research resources.">
  <PageHeading eyebrow="Papers & preprints" title="Publications" description="Research publications, with abstracts, citations, and links to the work." />
  {publications.some(item => item.data.placeholder) && <div class="notice">{realCount === 0 ? 'No verified publication information has been supplied yet. ' : ''}Entries marked “Editable placeholder” demonstrate the format and are not real publications.</div>}
  <form class="filter-bar" aria-label="Filter publications" hidden>
    <div class="filter-field"><label for="publication-search">Search publications</label><div class="search-wrap"><Icon name="search" size={17} /><input id="publication-search" type="search" placeholder="Title, author, keyword…" autocomplete="off" /></div></div>
    <div class="filter-field"><label for="publication-year">Year</label><select id="publication-year"><option value="">All years</option>{years.map(year => <option value={year}>{year}</option>)}{publications.some(item => item.data.year === null) && <option value="pending">Year pending</option>}</select></div>
    <div class="filter-field"><label for="publication-type">Publication type</label><select id="publication-type"><option value="">All types</option>{types.map(type => <option value={type}>{type}</option>)}</select></div>
    <button class="button" type="reset">Reset</button>
  </form>
  <p class="results-count" id="results-count" role="status" aria-live="polite">{realCount} publication{realCount === 1 ? '' : 's'}{publications.length !== realCount && ` · ${publications.length - realCount} editable placeholder${publications.length - realCount === 1 ? '' : 's'}`}</p>
  <noscript><p class="small muted">All entries are shown below. Search, filters, and citation copying are available with JavaScript enabled.</p></noscript>
  <div id="publication-list">{publications.map(publication => <PublicationEntry publication={publication} />)}</div>
  <div class="empty-state" id="no-results" hidden={publications.length > 0}><h2>{publications.length ? 'No matching publications' : 'Publications forthcoming'}</h2><p>{publications.length ? 'Try a different search, or reset the filters.' : 'Publication details will appear here when available.'}</p></div>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('.filter-bar');
  const search = document.querySelector<HTMLInputElement>('#publication-search');
  const year = document.querySelector<HTMLSelectElement>('#publication-year');
  const type = document.querySelector<HTMLSelectElement>('#publication-type');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-publication]')];
  const empty = document.querySelector<HTMLElement>('#no-results');
  const status = document.querySelector<HTMLElement>('#results-count');
  const initialStatus = status?.textContent || '';
  const filter = () => {
    const terms = (search?.value || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const entry of entries) {
      const matches = terms.every(term => entry.dataset.search?.includes(term)) && (!year?.value || entry.dataset.year === year.value) && (!type?.value || entry.dataset.type === type.value);
      entry.hidden = !matches;
      if (matches) visible++;
    }
    if (empty) empty.hidden = visible > 0;
    if (status) status.textContent = !terms.length && !year?.value && !type?.value ? initialStatus : `${visible} of ${entries.length} entries shown`;
  };
  if (form) {
    form.hidden = false;
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('input', filter);
    form.addEventListener('change', filter);
    form.addEventListener('reset', () => { requestAnimationFrame(filter); });
  }
</script>
