{
  "name": "academic-personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "npm run dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "new": "node scripts/new-content.mjs",
    "test": "playwright test",
    "test:subpath": "SITE_URL=https://example.github.io BASE_PATH=/academic/ OUT_DIR=./dist-subpath npm run build && TEST_BASE_PATH=/academic/ npm test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "typescript": "^5.9.0"
  }
}
